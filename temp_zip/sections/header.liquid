<header class="header-main" id="header-{{ section.id }}">
    <div class="container header-inner">
        <!-- Logo -->
        <a href="{{ routes.root_url }}" class="header-logo">
            <i class="fas fa-paw logo-icon"></i>
            <span class="logo-text">{{ section.settings.logo_text | default: 'DowodPupila' }}</span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="desktop-nav">
            {%- assign main_menu = section.settings.main_menu -%}
            {% if main_menu != blank and linklists[main_menu].links.size > 0 %}
                {% for link in linklists[main_menu].links %}
                    <a href="{{ link.url }}" class="nav-link">{{ link.title }}</a>
                {% endfor %}
            {% else %}
                <a href="/" class="nav-link">Strona Główna</a>
                <a href="/#shop" class="nav-link">Breloki NFC</a>
                <a href="/pages/regulamin" class="nav-link">Regulamin</a>
                <a href="/pages/polityka-prywatnosci" class="nav-link">Polityka Prywatności</a>
            {% endif %}
        </nav>

        <!-- Header Actions -->
        <div class="header-actions">
            <button type="button" class="cart-btn" id="cart-drawer-toggle" aria-label="Otwórz koszyk">
                <i class="fas fa-shopping-bag"></i>
                <span class="cart-badge" id="cart-icon-bubble">{{ cart.item_count }}</span>
            </button>

            <button type="button" id="mobile-toggle" class="mobile-burger" aria-label="Otwórz menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </div>

    <!-- MOBILE MENU OVERLAY -->
    <div class="mobile-menu-full-overlay" id="mobile-nav">
        <button type="button" id="mobile-close" class="m-close-btn">&times;</button>
        <div class="m-nav-content">
            <div class="m-nav-links">
                <a href="/" class="m-nav-item">Strona Główna</a>
                <a href="/#shop" class="m-nav-item">Breloki NFC</a>
                <a href="/pages/regulamin" class="m-nav-item">Regulamin</a>
                <a href="/pages/polityka-prywatnosci" class="m-nav-item">Polityka Prywatności</a>
            </div>
            <div class="m-nav-theme-box">
                <p class="m-theme-title">WYBIERZ SWÓJ KOLOR</p>
                <div class="m-theme-dots-wrap">
                    <div class="m-theme-dots-row">
                        <div class="m-theme-dot c-purple" data-theme="default"></div>
                        <div class="m-theme-dot c-orange" data-theme="orange"></div>
                        <div class="m-theme-dot c-blue" data-theme="blue"></div>
                        <div class="m-theme-dot c-green" data-theme="green"></div>
                    </div>
                    <div class="m-theme-dots-row">
                        <div class="m-theme-dot c-pink" data-theme="pink"></div>
                        <div class="m-theme-dot c-red" data-theme="red"></div>
                        <div class="m-theme-dot c-gray" data-theme="gray"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CART DRAWER (OFFICIAL SHOPIFY FORM) -->
    <div class="cart-backdrop" id="cart-overlay"></div>
    <form action="/cart" method="post" id="cart-drawer" class="cart-side-drawer">
        <div class="cart-drawer-top">
            <h2 style="font-weight: 900; margin: 0;">Twoje Zamówienie</h2>
            <button type="button" id="cart-drawer-close" class="cart-x">&times;</button>
        </div>
        <div class="cart-drawer-mid" id="cart-drawer-items">
            {% if cart.item_count > 0 %}
                {% for item in cart.items %}
                    <div class="c-item" data-key="{{ item.key }}">
                        <div class="c-item-img-box">
                            <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title }}">
                        </div>
                        <div class="c-item-details">
                            <h3 style="font-size: 1.1rem; font-weight: 900; margin-bottom: 0.2rem;">{{ item.product.title }}</h3>
                            <p style="font-size: 0.85rem; color: #94a3b8; margin-bottom: 0.5rem;">{{ item.variant.title }}</p>
                            <span class="c-item-price" style="color: var(--primary, #6c5ce7); font-weight: 800; display: block; margin-bottom: 0.8rem;">{{ item.final_price | money }}</span>
                            <div class="c-qty">
                                <button type="button" class="q-btn-ajax minus" data-key="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}">-</button>
                                <span class="q-val" style="font-weight: 800;">{{ item.quantity }}</span>
                                <button type="button" class="q-btn-ajax plus" data-key="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}">+</button>
                            </div>
                            <button type="button" class="c-remove-ajax" data-key="{{ item.key }}">Usuń</button>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <p style="text-align:center; padding: 3rem; color: #94a3b8;">Twój koszyk jest pusty.</p>
            {% endif %}
        </div>
        <div class="cart-drawer-bot">
            <div class="c-total">
                <span style="font-size: 1.2rem; font-weight: 900;">Razem:</span>
                <span style="font-size: 1.2rem; font-weight: 900;">{{ cart.total_price | money }}</span>
            </div>
            <button type="submit" name="checkout" class="c-checkout-btn">Złóż Zamówienie</button>
        </div>
    </form>
</header>

<style>
#shopify-section-header, .shopify-section-group-header-group { position: sticky; top: 0; z-index: 1000; }
.header-main { position: sticky; top: 0; width: 100%; background: #fff; z-index: 1000; padding: 1.2rem 0; border-bottom: 1px solid #f1f5f9; }
.header-inner { display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
.header-logo { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--primary); }
.logo-icon { font-size: 1.6rem; color: var(--primary); }
.logo-text { font-size: 1.5rem; font-weight: 900; letter-spacing: -1px; color: var(--primary); }
.desktop-nav { display: flex; gap: 2rem; position: absolute; left: 50%; transform: translateX(-50%); }
.nav-link { text-decoration: none; color: #1e293b; font-weight: 800; font-size: 0.95rem; }
.header-actions { display: flex; align-items: center; gap: 1.2rem; }
.cart-btn { background: none; border: none; cursor: pointer; position: relative; font-size: 1.5rem; color: #1e293b; }
.cart-badge { position: absolute; top: -5px; right: -8px; background: var(--primary); color: white; font-size: 0.6rem; font-weight: 800; width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 2px solid white; }
.mobile-burger { display: none; flex-direction: column; gap: 6px; background: none; border: none; cursor: pointer; }
.mobile-burger span { width: 26px; height: 2px; background: #1e293b; }

.mobile-menu-full-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100vh; background: #fff; z-index: 3000; display: flex; flex-direction: column; padding: 2rem; opacity: 0; visibility: hidden; transform: translateX(100%); transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
.mobile-menu-full-overlay.is-open { opacity: 1; visibility: visible; transform: translateX(0); }
.m-close-btn { position: absolute; top: 2rem; right: 2rem; font-size: 2.8rem; background: none; border: none; cursor: pointer; line-height: 1; }
.m-nav-content { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 4.5rem; text-align: center; }
.m-nav-links { display: flex; flex-direction: column; gap: 2.5rem; }
.m-nav-item { font-size: 2.4rem; font-weight: 900; color: #1e293b; text-decoration: none; }
.m-theme-title { font-size: 0.9rem; font-weight: 800; color: #94a3b8; margin-bottom: 2rem; }
.m-theme-dots-wrap { display: flex; flex-direction: column; gap: 1.5rem; }
.m-theme-dots-row { display: flex; gap: 1.5rem; justify-content: center; }
.m-theme-dot { width: 52px; height: 52px; border-radius: 50%; border: 3px solid #fff; box-shadow: 0 10px 20px rgba(0,0,0,0.08); cursor: pointer; }
.m-theme-dot.active { box-shadow: 0 0 0 3px #1e293b; }

.cart-side-drawer { position: fixed; top: 0; right: 0; width: 100%; max-width: 400px; height: 100vh; background: #fff; z-index: 3001; transform: translateX(100%); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); display: flex; flex-direction: column; box-shadow: -10px 0 30px rgba(0,0,0,0.1); margin: 0; border: none; }
.cart-side-drawer.is-open { transform: translateX(0); }
.cart-backdrop { position: fixed; top: 0; left: 0; width: 100%; height: 100vh; background: rgba(0,0,0,0.4); z-index: 2999; display: none; }
.cart-backdrop.is-open { display: block; }
.cart-drawer-top { padding: 2rem 1.5rem; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; }
.cart-x { background: none; border: none; font-size: 2rem; cursor: pointer; }
.cart-drawer-mid { flex: 1; overflow-y: auto; padding: 1.5rem; }
.c-item { display: flex; gap: 1rem; margin-bottom: 1.5rem; }
.c-item-img-box { width: 90px; height: 90px; background: #f8fafc; border-radius: 12px; padding: 5px; }
.c-item-img-box img { width: 100%; height: 100%; object-fit: contain; }
.c-qty { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.8rem; }
.q-btn-ajax { width: 34px; height: 34px; border-radius: 50%; border: 1px solid #e2e8f0; background: #fff; cursor: pointer; font-size: 1.2rem; font-weight: 600; display: flex; align-items: center; justify-content: center; }
.c-remove-ajax { background: none; border: none; color: #ff7675; text-decoration: underline; font-weight: 800; cursor: pointer; font-size: 0.9rem; }
.cart-drawer-bot { background: #f8fafc; padding: 2rem 1.5rem; }
.c-total { display: flex; justify-content: space-between; margin-bottom: 1.5rem; }
.c-checkout-btn { display: flex; width: 100%; padding: 1.1rem; background: var(--primary, #6c5ce7); color: #fff; border: none; font-weight: 800; border-radius: 100px; justify-content: center; cursor: pointer; font-size: 1rem; }

@media (max-width: 968px) { .desktop-nav { display: none; } .mobile-burger { display: flex; } }
.c-purple { background: #6c5ce7; } .c-orange { background: #ff7e67; } .c-blue { background: #4facfe; } .c-green { background: #2bc06a; } .c-pink { background: #ff758c; } .c-red { background: #ff4b2b; } .c-gray { background: #8793a0; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const mTog = document.getElementById('mobile-toggle'), mClos = document.getElementById('mobile-close'), mNav = document.getElementById('mobile-nav'),
          cTog = document.getElementById('cart-drawer-toggle'), cClos = document.getElementById('cart-drawer-close'), cOver = document.getElementById('cart-overlay'), cDraw = document.getElementById('cart-drawer');

    function toggle(el, ov, state) {
        if (!el) return;
        if (state) { el.classList.add('is-open'); if (ov) ov.classList.add('is-open'); document.body.style.overflow = 'hidden'; }
        else { el.classList.remove('is-open'); if (ov) ov.classList.remove('is-open'); document.body.style.overflow = ''; }
    }

    if (mTog) mTog.addEventListener('click', (e) => { e.preventDefault(); toggle(mNav, null, true); });
    if (mClos) mClos.addEventListener('click', (e) => { e.preventDefault(); toggle(mNav, null, false); });
    if (cTog) cTog.addEventListener('click', (e) => { e.preventDefault(); toggle(cDraw, cOver, true); });
    if (cClos) cClos.addEventListener('click', (e) => { e.preventDefault(); toggle(cDraw, cOver, false); });
    if (cOver) cOver.addEventListener('click', (e) => { e.preventDefault(); toggle(cDraw, cOver, false); });

    function updateCart(key, qty) { fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: key, quantity: qty }) }).then(() => location.reload()); }
    
    // KILL ALL REDIRECTS TO /CART
    document.addEventListener('submit', function(e) {
        const form = e.target.closest('form');
        if (form && form.action.includes('/cart/add')) {
            e.preventDefault();
            e.stopPropagation();
            fetch('/cart/add.js', { method: 'POST', body: new FormData(form) })
            .then(() => {
                localStorage.setItem('openCartDrawer', 'true');
                window.location.reload();
            });
            return false;
        }
    }, true);

    document.addEventListener('click', function(e) {
        if (e.target.closest('.q-btn-ajax')) {
            const btn = e.target.closest('.q-btn-ajax');
            updateCart(btn.dataset.key, parseInt(btn.dataset.qty));
        }
        if (e.target.closest('.c-remove-ajax')) {
            const btn = e.target.closest('.c-remove-ajax');
            updateCart(btn.dataset.key, 0);
        }
    });

    if (localStorage.getItem('openCartDrawer') === 'true') {
        localStorage.removeItem('openCartDrawer');
        toggle(cDraw, cOver, true);
    }

    const dots = document.querySelectorAll('.m-theme-dot'), saved = localStorage.getItem('shopTheme') || 'default';
    dots.forEach(d => { if (d.dataset.theme === saved) d.classList.add('active'); });
    if (saved !== 'default') document.documentElement.setAttribute('data-theme', saved);
    dots.forEach(d => {
        d.addEventListener('click', function() {
            dots.forEach(x => x.classList.remove('active'));
            this.classList.add('active');
            const t = this.dataset.theme;
            if (t === 'default') { document.documentElement.removeAttribute('data-theme'); localStorage.removeItem('shopTheme'); }
            else { document.documentElement.setAttribute('data-theme', t); localStorage.setItem('shopTheme', t); }
        });
    });
});
</script>

{% schema %}
{ "name": "Header", "settings": [ { "type": "text", "id": "logo_text", "label": "Nazwa Logo", "default": "DowodPupila" }, { "type": "link_list", "id": "main_menu", "label": "Menu główne" } ] }
{% endschema %}
